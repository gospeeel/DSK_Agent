# ==============================================================================
# База данных PostgreSQL (backend & migrations)
# ==============================================================================
DB_USER=postgres_user
DB_PASS=postgres_password
DB_NAME=dsk

# ==============================================================================
# Backend (Go user-server & staff-server)
# ==============================================================================
JWT_SECRET=replace-with-a-long-random-secret
MAX_MANAGER_DISCOUNT_PERCENT=5
MAX_SUPERVISOR_DISCOUNT_PERCENT=15
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ==============================================================================
# RabbitMQ (Message Broker)
# ==============================================================================
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=app.topic
RABBITMQ_QUEUE=agent-service
RABBITMQ_ROUTING_KEY=agent.chat.request
RABBITMQ_PREFETCH_COUNT=10

# ==============================================================================
# AI-агент (agent-service Python / GigaChat)
# ==============================================================================
APP_NAME=agent-service
LOG_LEVEL=INFO
GIGACHAT_CREDENTIALS=replace-with-authorization-key
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_VERIFY_SSL_CERTS=true
GIGACHAT_TIMEOUT=60
# GIGACHAT_CA_BUNDLE_FILE=/run/secrets/russian_trusted_root_ca.pem

