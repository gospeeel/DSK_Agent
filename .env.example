# Локальные значения имеют безопасные fallback в docker-compose.yml.
DB_USER=postgres_user
DB_PASS=postgres_password
DB_NAME=dsk
JWT_SECRET=replace-with-a-long-random-secret
MAX_MANAGER_DISCOUNT_PERCENT=5
MAX_SUPERVISOR_DISCOUNT_PERCENT=15

# Обязателен для реальных ответов AI-агента. Без него инфраструктура запустится,
# но обращения к GigaChat будут завершаться ошибкой авторизации.
GIGACHAT_CREDENTIALS=replace-with-authorization-key
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_VERIFY_SSL_CERTS=true
